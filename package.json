{
  "name": "tweakpane-plugin-html-color-picker",
  "version": "1.0.0",
  "description": "Tweakpane plugin for color picking using an HTML5 color input instead of the default color picker, which can sometimes be buggy.",
  "keywords": ["tweakpane", "tweakpane-plugin", "tweakpane-plugin-html-color-picker"],
  "main": "dist/tweakpane-plugin-html-color-picker.cjs",
  "module": "dist/tweakpane-plugin-html-color-picker.js",
  "browser": "dist/tweakpane-plugin-html-color-picker.umd.js",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "author": "Calrissian97",
  "license": "AGPL-3.0-only",
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "run-s clean build",
    "prepublishOnly": "npm test",
    "start": "run-p watch server",
    "test": "npm run server",
    "assets": "run-s clean build assets:version assets:zip",
    "assets:version": "node scripts/assets-append-version.js",
    "assets:zip": "zip -x '*types*' -j -r $(node scripts/dist-name.js)-$(cat package.json | npx json version).zip dist",
    "clean": "rimraf dist --glob \"*.tgz\" \"*.zip\"",
    "build": "run-p build:*",
    "build:dev": "rollup --config rollup.config.js",
    "build:dts": "tsc --project src/tsconfig-dts.json",
    "build:prod": "rollup --config rollup.config.js --environment BUILD:production",
    "format": "run-p format:*",
    "format:scss": "prettier --parser scss --write \"src/sass/**/*.scss\"",
    "format:ts": "eslint --ext .ts --fix \"src/**/*.ts\"",
    "server": "http-server -c-1 -o /test/browser.html",
    "watch": "run-p watch:*",
    "watch:sass": "onchange --initial --kill \"src/sass/**/*.scss\" -- npm run build:dev",
    "watch:ts": "onchange --initial --kill \"src/**/*.ts\" -- rollup --config rollup.config.js"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@tweakpane/core": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "glob": "^10.4.1",
    "http-server": "^14.1.1",
    "json": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "rollup": "^4.18.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "sass": "^1.77.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "tweakpane": "^3.0.0 || ^4.0.0"
  }
}
